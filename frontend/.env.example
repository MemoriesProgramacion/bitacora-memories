# Copiar como .env (no se sube al repositorio).

# Base de la API. Vacío = '/api' en el mismo dominio (recomendado: el backend
# sirve el frontend compilado, o un proxy reenvía /api al backend).
# Solo si la API vive en otro dominio:
# VITE_API_URL=https://api.midominio.co/api

# Backend al que Vite reenvía /api durante `npm run dev`.
VITE_API_PROXY=http://localhost:4000

# Enlace a la aplicación del carrito (sección Capitalización). Vacío = sin enlace.
VITE_CARRITO_URL=

# Verificación humana del login (Cloudflare Turnstile). Llave PÚBLICA del sitio.
# Vacía = sin verificación. Esta es la llave de PRUEBAS de Cloudflare (siempre
# pasa); en producción va la del sitio real:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
