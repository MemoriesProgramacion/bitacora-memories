PORT=4000
NODE_ENV=development

# Conexión a PostgreSQL (una sola base para Bitácora e inventario).
DATABASE_URL=postgres://bitacora:cambiar-esta-clave@localhost:5432/bitacora

# Nombre que sale en los PDF y en el inventario.
EMPRESA="Fundación Memories"

# Sesión. COOKIE_SECURE=1 cuando se sirva por HTTPS; CONFIAR_PROXY=1 si hay un
# proxy inverso (Nginx, balanceador) delante.
COOKIE_SECURE=0
# CONFIAR_PROXY=1
SESION_INACTIVIDAD_MIN=60
SESION_MAX_HORAS=12

# Orígenes extra que pueden hacer escrituras (normalmente no hace falta).
# En desarrollo ya se acepta el servidor de Vite (localhost:5173).
# CORS_ORIGIN=https://app.midominio.co

STORAGE_DIR=storage
MAX_MB_VIDEO=80
MAX_MB_PDF=15
MAX_MB_ARCHIVO=100

# Verificación humana del login (Cloudflare Turnstile). Va junto con
# VITE_TURNSTILE_SITE_KEY del frontend. Vacía = sin verificación. Esta es la
# llave secreta de PRUEBAS de Cloudflare (siempre pasa); en producción va la real.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
